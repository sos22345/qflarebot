{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qflarebot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // Bind the resources provisioned during the first successful build attempt.
  "kv_namespaces": [{ "binding": "KV", "id": "83ffe9cb7a214daa976b31314305da4f" }],
  "d1_databases": [{ "binding": "DB", "database_name": "qqbot", "database_id": "86420923-55f0-488c-9176-7bc739930fb0" }],

  "images": { "binding": "IMAGES" },
  "browser": { "binding": "BROWSER" },

  "triggers": { "crons": ["* * * * *"] },
  "vars": { "WORKER_NAME": "qflarebot" },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": true
}
